APP_ENV=local
APP_DEBUG=true

DATABASE_URL=postgresql+asyncpg://notifications:notifications@postgres:5432/notifications
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

RABBITMQ_EXCHANGE=notifications.exchange
RABBITMQ_DLX=notifications.dlx
RABBITMQ_HIGH_QUEUE=notifications.high
RABBITMQ_LOW_QUEUE=notifications.low
RABBITMQ_DLQ=notifications.dlq

WORKER_QUEUE_MODE=both
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=10,30,60
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TTL_SECONDS=300
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600
PROCESSING_LOCK_TTL_SECONDS=60
OUTBOX_CLAIM_TIMEOUT_SECONDS=300
OUTBOX_MAX_ATTEMPTS=5

SMS_PROVIDER_MODE=success
EMAIL_PROVIDER_MODE=success
